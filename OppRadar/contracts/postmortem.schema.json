{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Postmortem Record",
  "description": "M6 postmortem record schema (§3.1). One record per opp_id per revision.",
  "type": "object",
  "required": [
    "postmortem_id", "opp_id", "outcome", "outcome_ts",
    "market_price_at_scan",
    "p_baseline_low", "p_baseline_mid", "p_baseline_high",
    "confidence", "veto_status", "risk_level",
    "active_snapshot_type", "decision_snapshot_id",
    "is_topn", "actual", "virtual_notional",
    "revision", "is_latest", "created_at"
  ],
  "properties": {
    "postmortem_id":              { "type": "string", "description": "Unique ID (pm_{opp_id}_{ts})" },
    "opp_id":                     { "type": "string" },
    "outcome":                    { "type": "string", "enum": ["YES", "NO"] },
    "outcome_ts":                 { "type": "string", "description": "ISO8601 settlement time" },
    "market_price_at_scan":       { "type": "number" },
    "market_price_at_settlement": { "type": ["number", "null"] },
    "p_baseline_low":             { "type": "number", "minimum": 0, "maximum": 1 },
    "p_baseline_mid":             { "type": "number", "minimum": 0, "maximum": 1 },
    "p_baseline_high":            { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence":                 { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "veto_status":                { "type": "string", "enum": ["RED", "YELLOW", "GREEN"] },
    "veto_reason":                { "type": ["string", "null"] },
    "risk_level":                 { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "risk_reason":                { "type": ["string", "null"] },
    "filter_type":                { "type": ["string", "null"], "enum": ["RULE", "THIN", "SLOW", "UNKNOWN", null] },
    "filter_reason":              { "type": ["string", "null"] },
    "edge_buy_net":               { "type": ["number", "null"] },
    "edge_sell_net":              { "type": ["number", "null"] },
    "edge_net":                   { "type": ["number", "null"] },
    "predicted_direction":        { "type": ["string", "null"], "enum": ["BUY_YES", "BUY_NO", null] },
    "direction_correct":          { "type": ["integer", "null"] },
    "pnl_simulated":              { "type": ["number", "null"] },
    "snapshot_draft_id":          { "type": ["string", "null"] },
    "snapshot_deep_id":           { "type": ["string", "null"] },
    "active_snapshot_type":       { "type": "string", "enum": ["DRAFT", "DEEP"] },
    "decision_snapshot_id":       { "type": "string" },
    "decision_b5_run_id":         { "type": ["string", "null"] },
    "strategy_id":                { "type": ["string", "null"] },
    "is_topn":                    { "type": "integer", "enum": [0, 1] },
    "topn_rank":                  { "type": ["number", "null"] },
    "attribution_label":          { "type": ["string", "null"] },
    "attribution_reason":         { "type": ["string", "null"] },
    "attribution_confirmed":      { "type": ["integer", "null"] },
    "actual":                     { "type": "number", "enum": [0.0, 1.0] },
    "virtual_notional":           { "type": "number", "minimum": 0 },
    "revision":                   { "type": "integer", "minimum": 0 },
    "is_latest":                  { "type": "integer", "enum": [0, 1] },
    "created_at":                 { "type": "string" }
  }
}
