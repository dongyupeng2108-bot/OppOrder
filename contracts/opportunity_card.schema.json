{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpportunityCard",
  "description": "单个机会的标准数据单元，所有opportunities路由的基础合约",
  "type": "object",
  "required": [
    "id",
    "title",
    "score",
    "run_id",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "机会唯一ID"
    },
    "title": {
      "type": "string",
      "description": "机会标题"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "原始评分"
    },
    "run_id": {
      "type": "string",
      "description": "所属扫描Run的ID"
    },
    "created_at": {
      "type": "string",
      "description": "创建时间ISO8601"
    },
    "meta": {
      "type": "object",
      "description": "扩展字段，允许任意key"
    }
  }
}